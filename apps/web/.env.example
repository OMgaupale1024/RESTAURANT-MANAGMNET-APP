# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* is embedded in the browser bundle — never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# In production, point this at the API on a SAME-SITE host so the SameSite=Strict
# refresh cookie is delivered — e.g. https://api.oraoss.in/api/v1 with the web on
# https://app.oraoss.in. Baked into the bundle + CSP at build time (rebuild to change).
